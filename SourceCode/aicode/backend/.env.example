# =============================================
#   BACKEND — Environment Variables Template
#   Sao chép file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
# =============================================

# Môi trường chạy: development | production
NODE_ENV=development

# Cổng Backend (mặc định 5000)
PORT=5000

# ── Cơ sở dữ liệu MySQL ──────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=fruit_recognition_db

# ── JWT ──────────────────────────────────────
# Đổi thành chuỗi ngẫu nhiên dài, ví dụ chạy:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── AI Service ───────────────────────────────
# URL nội bộ đến Python AI Service
AI_SERVICE_URL=http://localhost:5001

# ── Upload ───────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
